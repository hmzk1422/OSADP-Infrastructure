# =============================================================================
# OSADP-Core — repository ignore rules
# =============================================================================

# ── Python ───────────────────────────────────────────────────────────────────
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/

# Environment variables / secrets
.env
*.key
*.pem

# ── Rust ─────────────────────────────────────────────────────────────────────
target/

# ── Data & runtime stores (RocksDB, downloaded archives, analytics caches) ──
data/
binance_cache/
research/state_space/
*.csv
*.parquet
*.db
*.sst

# ── Output artifacts (reports, charts, trade logs) ──────────────────────────
build/
*.log
*.png
main/logs/

# ── MoE ops/ runtime artifacts (fixed-name logs / csvs / reports / bundles) ─
strategy_system/strategy/moe/ops/log/
strategy_system/strategy/moe/ops/output/
strategy_system/strategy/moe/ops/report/
strategy_system/strategy/moe/ops/models/
!strategy_system/strategy/moe/ops/log/.gitkeep
!strategy_system/strategy/moe/ops/output/.gitkeep
!strategy_system/strategy/moe/ops/report/.gitkeep
!strategy_system/strategy/moe/ops/models/.gitkeep

# ── Editors / OS ─────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store

# ── Tooling / misc ──────────────────────────────────────────────────────────
dist/
_filelist.txt
filelist.txt

# ── RocksDB ─────────────────────────────────────────────────────────────────
data/
# ── UETS runtime: Unix-domain sockets + live captures ─────────────────────
uets/sockets/
uets/out/live/
market_data/live_db/
sockets/
